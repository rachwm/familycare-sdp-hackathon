# FamilyCare backend configuration
# Copy this file to .env only when you need to change the defaults.

FAMILYCARE_APP_NAME=FamilyCare API
FAMILYCARE_APP_VERSION=0.1.0
FAMILYCARE_ENVIRONMENT=development
FAMILYCARE_TIMEZONE=Asia/Kuala_Lumpur
FAMILYCARE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FAMILYCARE_RESIDENT_CHECK_IN_TIMEOUT_SECONDS=30
